{
  "claude-code": {
    "label": "Claude Code",
    "cli": "claude",
    "driver": "claude-stream",
    "env": {
      "CLAUDE_CODE_TMPDIR": "$TMP",
      "DISABLE_AUTOUPDATER": "1"
    },
    "homeFolders": [
      ".claude"
    ],
    "login": {
      "keychain": true
    },
    "signInHint": "Claude Code isn't signed in on this Mac. Open Terminal, run `claude`, then `/login`.",
    "models": [
      {
        "id": "opus",
        "label": "Opus",
        "efforts": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      {
        "id": "sonnet",
        "label": "Sonnet",
        "efforts": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      {
        "id": "haiku",
        "label": "Haiku",
        "efforts": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    ],
    "efforts": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ]
  },
  "codex": {
    "label": "Codex",
    "cli": "codex",
    "driver": "codex-app-server",
    "homeFolders": [
      ".codex"
    ],
    "login": {
      "files": [
        {
          "path": ".codex/auth.json",
          "scratch": [
            ".codex/.auth-*",
            ".codex/auth.json.lock",
            ".codex/auth.lock"
          ]
        }
      ]
    },
    "signInHint": "Codex isn't signed in on this Mac. Open Terminal and run `codex login`.",
    "efforts": [
      "low",
      "medium",
      "high"
    ]
  }
}
