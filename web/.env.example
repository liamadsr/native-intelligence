# Native Intelligence web app: environment variables.
#
# Copy this file to .env.local and fill in what you need. `next dev` loads .env.local,
# and the eve agents' dev servers inherit it. Never commit .env.local.
#
# The first group runs the core app (sign-in, chat, connections). Everything after it turns on one feature;
# leave a feature's variables empty and that feature stays off or fails when used.
# Variables Vercel sets on its own (VERCEL_URL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA and
# the like) and NODE_ENV are not listed.
#
# Secrets: make each one a long random string, e.g. `openssl rand -hex 32`, unless the
# comment says otherwise.

# --- Required for the core app (sign-in, chat, connections) ------------------------

# The app's public origin. The eve agents call the app back here, so it must match the dev server's port.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase project URL (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (public) key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel AI Gateway key. The eve agents' model calls and text embeddings go through the Gateway.
AI_GATEWAY_API_KEY=
# The root internal secret between the app and the eve agents. Every other internal secret falls back to it.
RUN_SKILL_INTERNAL_SECRET=
# Encrypts stored OAuth tokens and credentials. 32 bytes, base64: `openssl rand -base64 32`.
CREDENTIAL_ENCRYPTION_KEY=
# Points the Inngest SDK at the local Inngest dev server (`npm run dev:inngest`). Leave unset in production.
INNGEST_DEV=1

# --- Internal secrets (optional in dev, one distinct value each in production) ------
# Each falls back to RUN_SKILL_INTERNAL_SECRET when empty.

# coding-agent, work-agent and onboarding-researcher.
AGENT_RUN_INTERNAL_SECRET=
# chat-agent and the desktop's ask route.
CHAT_INTERNAL_SECRET=
# utility and web-research agents.
UTILITY_INTERNAL_SECRET=
# live-agent (the meeting agent).
LIVE_AGENT_INTERNAL_SECRET=
# Signs the tokens of the agent that runs on the person's Mac.
LOCAL_AGENT_TOKEN_SECRET=
# Signs the cloud browser's relay token.
BROWSER_INTERNAL_SECRET=

# --- Background jobs -------------------------------------------------------------------

# Bearer token Vercel Cron sends to /api/cron/*. Cron routes answer 503 without it.
CRON_SECRET=
# Inngest Cloud event key (production). Read by the Inngest SDK.
INNGEST_EVENT_KEY=
# Inngest Cloud signing key (production). Read by the Inngest SDK.
INNGEST_SIGNING_KEY=

# --- Vercel ----------------------------------------------------------------------------

# Vercel OIDC token from `vercel env pull`: Gateway auth when AI_GATEWAY_API_KEY is empty, and Vercel Sandbox auth (the cloud browser). Short-lived.
VERCEL_OIDC_TOKEN=
# Lets the eve agents through Vercel Deployment Protection on preview URLs. Vercel sets it when "Protection Bypass for Automation" is on.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Sign-in ---------------------------------------------------------------------------

# Google OAuth client for "Sign in with Google" run by the app itself. Empty: Google sign-in uses Supabase's own flow.
GOOGLE_SIGN_IN_CLIENT_ID=
# Secret for the client above.
GOOGLE_SIGN_IN_CLIENT_SECRET=
# Exact registered callback. Default: <origin>/auth/google/callback.
GOOGLE_SIGN_IN_REDIRECT_URI=
# "Continue with ChatGPT" partner client id. Empty (and no CHATGPT_DEV_HOST_ID): the option is hidden.
CHATGPT_CLIENT_ID=
# Secret for the partner client above.
CHATGPT_CLIENT_SECRET=
# Dev only: this machine's host id for a self-serve ChatGPT client registration. Ignored in production.
CHATGPT_DEV_HOST_ID=
# Exact registered callback. Default: <origin>/auth/chatgpt/callback.
CHATGPT_REDIRECT_URI=

# --- Connected accounts (all OAuth providers) ------------------------------------------

# Origin used in OAuth callbacks: <base>/api/oauth/<provider>/callback. Default: NEXT_PUBLIC_APP_URL.
OAUTH_REDIRECT_BASE_URL=
# Signs OAuth state. Falls back to a key derived from CRON_SECRET; one of the two is required in production.
OAUTH_STATE_SECRET=

# --- Email and calendar ----------------------------------------------------------------

# Google OAuth client for Gmail and Google Calendar.
GOOGLE_CLIENT_ID=
# Secret for the client above.
GOOGLE_CLIENT_SECRET=
# Pub/Sub topic Gmail push notifications publish to (projects/<project>/topics/<topic>).
GMAIL_PUBSUB_TOPIC=
# Service account email the Pub/Sub push subscription signs as; turns on signed-push checks.
GMAIL_PUSH_SERVICE_ACCOUNT=
# Only when the push subscription's audience is not <NEXT_PUBLIC_APP_URL>/api/webhooks/gmail.
GMAIL_PUSH_AUDIENCE=
# Static ?token= on the Gmail push endpoint, checked when GMAIL_PUSH_SERVICE_ACCOUNT is empty. Fails closed in production without it.
GMAIL_WEBHOOK_TOKEN=
# Microsoft OAuth client for Outlook mail and calendar.
MICROSOFT_CLIENT_ID=
# Secret for the client above.
MICROSOFT_CLIENT_SECRET=
# Prefix of the clientState on Microsoft Graph subscriptions; Outlook sync makes none without it.
OUTLOOK_WEBHOOK_SECRET=

# --- Outgoing email (Resend) -----------------------------------------------------------

# Resend API key for the app's own emails (invites, notices, campaigns).
RESEND_API_KEY=
# Sender of those emails, e.g. `Your Name <you@your-domain.com>`, on a domain verified in Resend. Empty: no email is sent.
EMAIL_FROM=
# HMAC key for unsubscribe links in campaign emails.
UNSUBSCRIBE_SECRET=

# --- Task apps, CRM and marketing ------------------------------------------------------

# Asana OAuth client (push actions as tasks).
ASANA_CLIENT_ID=
# Secret for the client above.
ASANA_CLIENT_SECRET=
# 'true' registers Asana webhooks even to a localhost or http target (normally skipped).
ASANA_ALLOW_INSECURE_WEBHOOK_TARGET=
# Atlassian OAuth 2.0 (3LO) client for Jira Cloud.
JIRA_CLIENT_ID=
# Secret for the client above.
JIRA_CLIENT_SECRET=
# 'true' registers Jira webhooks even to a localhost or http target (normally skipped).
JIRA_ALLOW_INSECURE_WEBHOOK_TARGET=
# Linear OAuth client.
LINEAR_CLIENT_ID=
# Secret for the client above.
LINEAR_CLIENT_SECRET=
# Signing secret of the Linear app's webhook (/api/webhooks/linear). The receiver refuses everything without it.
LINEAR_WEBHOOK_SECRET=
# HubSpot OAuth client (CRM contact and company sync).
HUBSPOT_CLIENT_ID=
# Secret for the client above.
HUBSPOT_CLIENT_SECRET=
# Brevo OAuth client id.
BREVO_CLIENT_ID=

# --- GitHub ----------------------------------------------------------------------------

# GitHub OAuth client (repos for coding runs).
GITHUB_CLIENT_ID=
# Secret for the client above.
GITHUB_CLIENT_SECRET=
# HMAC secret of the GitHub webhook (/api/webhooks/github).
GITHUB_WEBHOOK_SECRET=
# Extra check apps whose failures start a CI-fix run, comma-separated (e.g. vercel). GitHub Actions always counts.
CI_FIX_CHECK_APPS=
# Optional read-only token for the public /roadmap page's GitHub fetch. Unset works (60 requests an hour per IP); a token raises the limit.
GITHUB_ROADMAP_TOKEN=

# --- Slack (through Vercel Connect) ----------------------------------------------------

# The Vercel Connect connector for Slack (uid or scl_ id). Empty: Slack is off.
SLACK_CONNECTOR=
# Your Slack app's id (A...). Events from any other app are dropped.
SLACK_APP_ID=
# '1' shows "Add to Slack" in Settings.
SLACK_SELF_INSTALL=
# Slack signing secret, for interactivity requests that don't come through Connect.
SLACK_SIGNING_SECRET=

# --- Billing (Stripe) ------------------------------------------------------------------
# The subscription webhook is a Supabase Edge Function (supabase/functions/stripe-webhook):
# its STRIPE_WEBHOOK_SECRET goes in the Supabase function's secrets, not here.

# Stripe secret key (sk_test_... in dev). Billing and Stripe Connect share it.
STRIPE_SECRET_KEY=
# Origin Stripe Checkout returns to: allowed as a return origin, and the fallback when the request's isn't. Empty: the hosted domain. Set it to your app's origin.
NEXT_PUBLIC_SITE_URL=
# 'true' lets AI requests through when the usage-limit check itself fails (incident escape hatch).
BILLING_FAIL_OPEN=

# --- Payments for your customers (Stripe Connect) --------------------------------------

# '1' allows Connect with a live secret key. A test key always works.
STRIPE_CONNECT_LIVE=
# Connect OAuth client id (ca_...), for linking an existing Stripe account. Empty: linking is off.
STRIPE_CONNECT_CLIENT_ID=
# Signing secret of the Connect snapshot-event endpoint (/api/webhooks/stripe-connect).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Signing secret of the Connect v2 thin-event destination (/api/webhooks/stripe-connect/v2).
STRIPE_CONNECT_V2_WEBHOOK_SECRET=

# --- Texting (Twilio) ------------------------------------------------------------------

# Twilio account SID.
TWILIO_ACCOUNT_SID=
# Twilio auth token. Also verifies incoming webhooks; without it every Twilio webhook is refused.
TWILIO_AUTH_TOKEN=
# Messaging service SID texts are sent from. Either this or TWILIO_PHONE_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
# The deployment's shared number people text, E.164 (e.g. +15555550100). It's the From when no messaging service is set.
TWILIO_PHONE_NUMBER=
# A separate sign-up number, E.164, when there is one.
TWILIO_SIGNUP_NUMBER=
# Public SMS webhook URL override. Default: <NEXT_PUBLIC_APP_URL>/api/twilio/sms.
TWILIO_WEBHOOK_URL=

# --- Phone calls (OpenAI GPT-Live) -----------------------------------------------------

# OpenAI project key calls are answered with. Empty: calls aren't answered.
GPT_LIVE_API_KEY=
# Signing secret of the OpenAI webhook (/api/calls/live).
GPT_LIVE_WEBHOOK_SECRET=
# Shared header value your SIP trunk sends (X-NI-Trunk). Calls without it are refused, dev included. `openssl rand -hex 32`.
GPT_LIVE_TRUNK_SECRET=
# Dev only: a caller phone (E.164) mapped to the user and workspace below.
GPT_LIVE_DEV_CALLER_PHONE=
# Dev only: the user id that caller maps to.
GPT_LIVE_DEV_USER_ID=
# Dev only: the workspace id that caller maps to.
GPT_LIVE_DEV_WORKSPACE_ID=
# Dev only: '1' answers a call without caller attestation.
GPT_LIVE_DEV_SKIP_ATTESTATION=

# --- Transcription ---------------------------------------------------------------------

# Deepgram key. The app mints short-lived tokens from it for live transcription, and a cron reconciles usage.
DEEPGRAM_API_KEY=

# --- Research and embeddings -----------------------------------------------------------

# Exa key for company deep search and web search.
EXA_API_KEY=
# Google AI key, read by @ai-sdk/google for attachment (PDF and image) embeddings.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Cloud browser (Vercel Sandbox) ----------------------------------------------------

# Base64 PKCS#8 DER private key that signs live-view tokens (scripts/cloud-browser/new-signing-key.mjs). Empty: no live view.
CLOUD_BROWSER_SIGNING_KEY=
# Vercel Sandbox snapshot every cloud browser starts from (scripts/cloud-browser/build-base-snapshot.sh).
CLOUD_BROWSER_BASE_SNAPSHOT_ID=
# Public origin a sandbox reaches the app at. Needed in local dev: a sandbox can't reach localhost.
CLOUD_BROWSER_RELAY_ORIGIN=

# --- Product analytics (PostHog) -------------------------------------------------------

# PostHog project key. Empty: no analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host. Default: /ingest in the browser (proxied to PostHog US), https://us.i.posthog.com on the server.
NEXT_PUBLIC_POSTHOG_HOST=

# --- Error reporting (Sentry) ---------------------------------------------------------

# Sentry DSN; production builds report errors to it. Empty: Sentry is off and the build uploads nothing.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry organization slug, for uploading source maps at build time (with the DSN and SENTRY_PROJECT).
SENTRY_ORG=
# Sentry project slug, for uploading source maps at build time.
SENTRY_PROJECT=
# Sentry auth token the build uses to upload source maps.
SENTRY_AUTH_TOKEN=

# --- Desktop app download --------------------------------------------------------------

# Public URL of the macOS app (.dmg) that /api/download redirects to; set it before building. Empty: no download buttons, and /api/download is 404.
APP_DOWNLOAD_URL=
# Public URL of the Windows installer, for /api/download?platform=windows; set it before building. Empty: no Windows download.
APP_DOWNLOAD_URL_WINDOWS=

# --- Switches and tuning (leave empty for the defaults) -------------------------------

# Risky-call reviewer: default | blocking | shadow. See CLAUDE.md.
ACTION_REVIEW_MODE=
# 'false' stops agents making a first pass on drafting work, everywhere.
AGENT_AUTO_ATTEMPT_ENABLED=
# '1' or 'true' turns chat's quick helpers off.
CHAT_HELPERS_DISABLED=
# 'off' stops automatic escalation to the strongest model tier.
AUTO_MODEL_ESCALATION=
# 'off' makes the outbound text router log instead of send.
REACH_ROUTE_LIVE=
# Look-ahead messages: empty or 'all' = live, 'off' = shadow, or a comma-separated list of user ids.
LOOK_AHEAD_LIVE=
# 'false' skips the proposal age-out cron.
AGE_OUT_ENABLED=
# 'false' skips the triage reconciler cron.
RECONCILER_ENABLED=
# 'true' lets flows dispatch coding agents that open PRs. Off by default.
RUN_AGENT_DISPATCH_ENABLED=
# How deep flow-triggers-flow chains may go. Default 2.
FLOW_TRIGGER_MAX_DEPTH=
# Work-run watch step budget in ms, 5000 to 290000. Default 240000.
WORK_WATCH_STEP_BUDGET_MS=
# 'all' tags Gateway requests with the user, for per-user usage.
GATEWAY_USER_TAGGING=
# 'all' makes the admin AI-usage page default to the Gateway report.
GATEWAY_USAGE_REPORTING=
# Fallback input price (USD per million tokens) of the decision model when the Gateway reports no cost. Default 0.042.
JEV_INPUT_USD_PER_MILLION=
# 'false' sends the two eval graders straight to Anthropic instead of the Gateway (needs ANTHROPIC_API_KEY).
USE_GATEWAY=
# Anthropic key, only for the eval graders when USE_GATEWAY=false.
ANTHROPIC_API_KEY=

# --- Admin panel -----------------------------------------------------------------------

# Who may use the admin panel (and skips billing): comma-separated email addresses. Empty: no admins.
ADMIN_EMAILS=

# The admin panel can switch its data source to a second ("production") project.
# Second Supabase project URL.
PROD_SUPABASE_URL=
# Second Supabase project's service role key.
PROD_SUPABASE_SERVICE_ROLE_KEY=
# Stripe secret key for the second environment.
PROD_STRIPE_SECRET_KEY=

# --- Local development only ------------------------------------------------------------

# Separate .next dir, so a second `next dev` on the same checkout doesn't collide.
NEXT_DEV_DIST_DIR=
# Turbopack root, when node_modules is a symlink outside the checkout (git worktrees).
NEXT_DEV_TURBOPACK_ROOT=
# Path of the browser-agent debug trace scope file. Default: <tmpdir>/ni-browser-trace-scope.json.
NI_BROWSER_TRACE_SCOPE_FILE=
