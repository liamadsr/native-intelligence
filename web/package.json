{
  "name": "radiant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/copy-ort-runtime.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/studio-scene-runtime.mjs && npm run eve:prune-runs",
    "dev": "next dev",
    "eve:prune-runs": "tsx scripts/eve-prune-stuck-runs.ts --apply",
    "dev:inngest": "npx inngest-cli@latest dev",
    "dev:all": "concurrently --names next,inngest --prefix-colors blue,magenta \"npm run dev\" \"npm run dev:inngest\"",
    "build": "vitest run && node scripts/cloud-browser/build-assets.mjs && node scripts/copy-ort-runtime.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/studio-scene-runtime.mjs && NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "postinstall": "patch-package",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "typegen": "sanity schema extract --path=src/sanity/extract.json && sanity typegen generate && rm ./src/sanity/extract.json",
    "invite": "npx tsx scripts/send-invites.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "cd evals/chat-agent && node --env-file-if-exists=../../.env.evals ../../node_modules/eve/bin/eve.js eval --url \"${EVE_EVAL_URL:-http://localhost:3001/eve/chat-agent}\"",
    "eval:safety": "npm run eval -- safety",
    "eval:fixture": "tsx scripts/eval-fixture.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "bootstrap:dev": "bash scripts/bootstrap-dev-env.sh",
    "sounds": "python3 scripts/sounds/make-sounds.py"
  },
