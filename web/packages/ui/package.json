{
  "name": "@native-intelligence/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Native Intelligence presentational design-system kit (shadcn/ui primitives + marketing components), built from the app source.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.0",
    "tsup": "^8.5.0"
  }
}
