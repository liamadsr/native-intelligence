# Copy to .env in this folder on the server. Owner root, mode 600, never in git:
#   sudo install -m 600 -o root -g root .env.example .env && sudo nano .env
# Keep a copy of the filled-in file in the password manager.

# Lets the app send events (the SDK puts it in the URL: POST /e/<key>).
# The same value goes in the app's INNGEST_EVENT_KEY.
# Generate: openssl rand -hex 32
INNGEST_EVENT_KEY=

# Signs every request between the server and the app, and is the bearer token
# for the server's API. Must be hex with an even number of characters.
# The same value goes in the app's INNGEST_SIGNING_KEY.
# Generate: openssl rand -hex 32
INNGEST_SIGNING_KEY=

# Password of the `inngest` Postgres role. It is written into a connection
# URL, so keep it to letters and digits.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# The app's public serve endpoint: https://<the app's production domain>/api/inngest
# The app registers under the host this request arrives on, and the server
# then calls that URL to run every function, so use the domain production
# answers on without a redirect. Only the `sync` service below uses it: the
# server itself is not started with this URL (compose.yaml says why).
INNGEST_SDK_URL=

# Turns on the `sync` service, which asks the app to re-register its
# functions every minute (without it a deploy that adds or changes a function
# never reaches this server). Leave commented until the app points at this
# server, then uncomment and run `sudo docker compose up -d`.
#COMPOSE_PROFILES=sync

# Seconds between those requests. Optional, default 60. Each one is a request
# to the app's serve endpoint.
#SYNC_INTERVAL_SECONDS=
