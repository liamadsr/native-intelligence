# Where the hosted Supabase project is. Read by the scripts in this folder.
#
# Copy to .env in this folder on the server. Owner root, mode 600, never in git:
#   sudo install -m 600 -o root -g root .env.example .env && sudo nano .env
# Delete the file when the move is over: these are production credentials.
#
# The self-hosted side needs nothing here. Its database password, pooler
# tenant, public host name and S3 keys are read from ../stack/.env.

# The hosted database, as a connection string with the password in it.
# Dashboard: Connect, "Session pooler" (port 5432, user postgres.<project ref>).
# Use the session pooler, not "Direct connection": the direct host only has
# an IPv6 address, and containers on this server have no IPv6 route.
# A password with characters like @ : / ? # must be percent-encoded.
SOURCE_DB_URL=

# The hosted project's S3 endpoint: its URL followed by /storage/v1/s3.
# Dashboard: Storage, S3 Configuration (or Settings), "Endpoint".
SOURCE_S3_ENDPOINT=
# The region shown on that same page.
SOURCE_S3_REGION=
# An access key made on that page for this move ("New access key"). The
# secret is shown once. Delete the key there when the move is over.
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
