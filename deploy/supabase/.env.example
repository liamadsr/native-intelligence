# Settings of the self-hosted Supabase stack.
#
# Copy to stack/.env on the server (Supabase's own tools look for it there).
# Owner root, mode 600, never in git:
#   sudo install -m 600 -o root -g root .env.example stack/.env
# Then, from stack/:
#   sudo sh utils/generate-keys.sh --update-env     fills section 1, except DASHBOARD_USERNAME
#   sudo nano .env                                  sections 2 to 6, by hand
#   sudo ../check-env.sh                            says what is still empty
# Keep a copy of the filled-in file in the password manager: with the two data
# volumes and the backups it is all that is needed to rebuild this stack.
#
# Rules of the file: no spaces around =, no quotes unless a line shows them,
# and nothing after a value on the same line.
#
# Every setting of Supabase's own example file is here too (after-update.sh
# checks that when a release is taken); the ones this install does not use
# are in section 8. No secret, key, address or account name is in this file.
# The few lines that do carry a value are fixed, non-secret settings that
# Supabase's compose file has no default for.

# Which compose files make up the stack: theirs, then ours on top of it.
# `sudo sh run.sh config` shows the list in effect.
COMPOSE_FILE=docker-compose.yml:../compose.override.yaml


# ---------------------------------------------------------------------------
# 1. Secrets generated here
#
# `sudo sh utils/generate-keys.sh --update-env` writes all of these except
# DASHBOARD_USERNAME, which you choose yourself (and the three keys of
# section 2, which are then replaced by hand). It leaves the old file behind
# as .env.old: delete that afterwards.
# ---------------------------------------------------------------------------

# Password of every database role the services use (postgres, supabase_admin,
# authenticator and the rest). Only read the first time Postgres starts on an
# empty volume; to change it later use utils/db-passwd.sh, never this line.
POSTGRES_PASSWORD=

# The login for Studio. Asked for by the gateway on its own port, which is
# only reachable through the SSH tunnel. The user name is yours to choose and
# is the one line of this section the generator leaves empty. The password
# needs at least one letter and no special characters.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Signs cookies and internal messages of Realtime and the pooler (64+ characters).
SECRET_KEY_BASE=
# Encrypts what Realtime stores in its own schema (exactly 16 characters).
REALTIME_DB_ENC_KEY=
# Encrypts what the pooler stores about the database (exactly 32 characters).
VAULT_ENC_KEY=
# Encrypts connection strings between Studio and its helper (32+ characters).
PG_META_CRYPTO_KEY=

# The key pair for Storage's S3 protocol. Used by the migration scripts and
# the nightly file backup; nothing public uses it.
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=


# ---------------------------------------------------------------------------
# 2. COPIED FROM THE HOSTED PROJECT, so that everything already issued keeps
#    working: the keys compiled into the apps, and every signed-in session.
#
# The hosted project signs with one shared secret (HS256) and nothing else:
# its JWKS is empty. This stack is set up the same way. After
# generate-keys.sh has run, REPLACE these three with the hosted project's.
# ---------------------------------------------------------------------------

# The hosted project's legacy JWT secret, exactly as shown.
# Dashboard: Project Settings, JWT Keys, "Legacy JWT secret".
JWT_SECRET=

# The hosted project's two legacy API keys, exactly as shown, character for
# character: the gateway compares the key it is sent with these strings. They
# are JWTs signed with the secret above.
# Dashboard: Project Settings, API Keys, "Legacy API keys": anon and service_role.
ANON_KEY=
SERVICE_ROLE_KEY=

# How long an access token lives, in seconds. The hosted value.
# Dashboard: Authentication, Sessions (or JWT Keys), "Access token expiry".
JWT_EXPIRY=

# LEAVE THESE SIX EMPTY. They belong to the newer key scheme (sb_publishable_
# and sb_secret_ keys, tokens signed with a key pair). The hosted project does
# not use it, and filling them makes Auth sign new sessions differently. Do
# not run utils/add-new-auth-keys.sh.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


# ---------------------------------------------------------------------------
# 3. Where this stack is on the internet
# ---------------------------------------------------------------------------

# The public address of the API, with https and no trailing slash: the host
# Caddy serves for Supabase. Storage also takes from it the one host name it
# accepts S3 requests for, so the backup and the migration scripts read it.
# During a rehearsal this is the rehearsal host name.
SUPABASE_PUBLIC_URL=

# The same address followed by /auth/v1. Auth puts it in OAuth callbacks and
# into every token it issues as the issuer.
API_EXTERNAL_URL=


# ---------------------------------------------------------------------------
# 4. AUTH SETTINGS THAT TODAY EXIST ONLY IN THE HOSTED DASHBOARD
#
# None of these is in the database, so none comes over with it. Each is read
# off the hosted project's dashboard (Authentication) and typed in here.
# ../README.md, "Auth settings", has the full list with where each one is.
# ---------------------------------------------------------------------------

# "Site URL": the app's own address. The email templates build their links
# from it ({{ .SiteURL }}/auth/confirm?...), and it is where Auth sends
# someone when no other redirect is allowed.
SITE_URL=

# "Redirect URLs": the allow-list, comma-separated, no spaces, wildcards as
# in the dashboard. Everything on the hosted list, including the desktop and
# iOS callback addresses.
ADDITIONAL_REDIRECT_URLS=

# "Allow new users to sign up": false here when it is ON there.
DISABLE_SIGNUP=
# The Email provider is on: true.
ENABLE_EMAIL_SIGNUP=
# "Confirm email": false here when it is ON there (true would sign people up
# without the confirmation email).
ENABLE_EMAIL_AUTOCONFIRM=
# "Allow anonymous sign-ins".
ENABLE_ANONYMOUS_USERS=
# The Phone provider, and whether a phone number is trusted unconfirmed.
# false for both unless the hosted project has phone sign-in on.
ENABLE_PHONE_SIGNUP=
ENABLE_PHONE_AUTOCONFIRM=

# --- Google (Authentication, Sign In / Providers, Google) ---
# true or false.
GOOGLE_ENABLED=
# "Client IDs", exactly as in the dashboard: comma-separated, no spaces. The
# first is the web client used for the redirect flow; all of them are
# accepted when an app signs in with a Google ID token.
GOOGLE_CLIENT_ID=
# "Client Secret (for OAuth)".
GOOGLE_SECRET=
# "Skip nonce checks": true only if it is on there. Optional, default false.
#GOOGLE_SKIP_NONCE_CHECK=

# --- Apple (Authentication, Sign In / Providers, Apple) ---
# true or false.
APPLE_ENABLED=
# "Client IDs": the Services ID and the app bundle IDs, comma-separated.
APPLE_CLIENT_ID=
# "Secret Key (for OAuth)": the client secret generated from the Apple key.
# Apple lets it live six months at most; it has to be regenerated here, as it
# was there.
APPLE_SECRET=

# --- The sign-up check (Authentication, Hooks, "Before User Created") ---
# true makes Auth ask the Postgres function public.hook_require_work_email
# before it creates an account. The function comes over with the database;
# this switch does not. Leave it false until the database has been restored:
# with the hook on and the function missing, nobody can sign up.
HOOK_BEFORE_USER_CREATED_ENABLED=

# --- Sending email (Authentication, Emails, SMTP Settings) ---
# "Sender email address" and "Sender name".
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
# Host, port, username and password of the SMTP provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Email subjects (Authentication, Emails, Templates) ---
# The five templates themselves are the files in web/supabase/templates,
# which the stack serves to Auth (see ../README.md). The SUBJECT of each is a
# dashboard field and goes here. Empty means Auth's built-in English subject.
# Put a subject in double quotes.
MAILER_SUBJECTS_CONFIRMATION=
MAILER_SUBJECTS_INVITE=
MAILER_SUBJECTS_MAGIC_LINK=
MAILER_SUBJECTS_RECOVERY=
MAILER_SUBJECTS_EMAIL_CHANGE=


# ---------------------------------------------------------------------------
# 5. The Stripe webhook function
# ---------------------------------------------------------------------------

# Must stay false: Stripe calls the function without any Supabase key, and
# the function checks Stripe's signature itself. This switch is for the whole
# functions service, and stripe-webhook is the only function on it.
FUNCTIONS_VERIFY_JWT=false

# The Stripe secret key the hosted function uses today
# (hosted dashboard: Edge Functions, Secrets, STRIPE_SECRET_KEY).
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint in Stripe. Editing that
# endpoint's URL in place keeps this value; creating a new endpoint gives a
# new one.
STRIPE_WEBHOOK_SECRET=

# Memory for the functions container, shared by all workers.
FUNCTIONS_MEMORY_LIMIT=2g


# ---------------------------------------------------------------------------
# 6. Names of this install
# ---------------------------------------------------------------------------

# The pooler's name for this database. It is part of the user name when
# connecting through the pooler: postgres.<this value>. Letters and digits.
POOLER_TENANT_ID=

# What Studio calls the organization and the project. Shown, nothing more.
STUDIO_DEFAULT_ORGANIZATION=
STUDIO_DEFAULT_PROJECT=

# Storage. The first is the folder its files go under inside the volume, the
# second is the region S3 clients must name when they sign a request, the
# third is Storage's own name for this install. Any short lower-case words;
# once files are stored, the first and the third must never change.
GLOBAL_S3_BUCKET=
REGION=
STORAGE_TENANT_ID=


# ---------------------------------------------------------------------------
# 7. Fixed settings: leave as they are
# ---------------------------------------------------------------------------

# Where the services find Postgres inside Docker.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# The pooler: connections it keeps open to Postgres per pool, clients it
# accepts per pool, and its own bookkeeping connections.
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# The data API: schemas it serves, the most rows one request returns, and the
# schemas added to every request's search path. The hosted defaults.
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# The largest file Storage takes, in bytes (../compose.override.yaml). Empty:
# Supabase's own 50 MB. Set to 2147483648 only at step 23's "Call audio
# files" A2 (../README.md), after migration 651 and its check that every
# bucket has a limit of its own; then `sudo sh run.sh recreate storage`.
# Raised, any bucket made later without a limit of its own takes files that
# large: give every new bucket one. The line may be left out (check-env.sh
# notes it): that is the 50 MB too.
STORAGE_FILE_SIZE_LIMIT=

# The path Auth uses in links it builds by itself. The app's templates build
# their own links, so these only matter for a template that is missing.
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"


# ---------------------------------------------------------------------------
# 8. Not used by this install
#
# Supabase's compose files name these, so they are kept: an unset one makes
# Compose print a warning, and one of them stops the file from being read.
# Nothing here is reachable or running.
# ---------------------------------------------------------------------------

# Host ports. Nothing is published on the host (../compose.override.yaml
# removes every `ports:`), but their file has to be readable first.
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
POOLER_PROXY_PORT_TRANSACTION=6543

# Studio's AI assistant. Empty: off.
OPENAI_API_KEY=

# The logs and analytics add-on (docker-compose.logs.yml), which is off.
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=

# The MinIO add-on (docker-compose.s3.yml). Files are stored on a volume.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# imgproxy. Image transformation is off and the container does not run.
IMGPROXY_AUTO_WEBP=true

# Supabase's own Caddy and nginx add-ons. HTTPS is ../edge.
PROXY_DOMAIN=
CERTBOT_EMAIL=
