# One line per backup job. Times are UTC.
#
# A job is `backup-postgres <name>`. Its settings come from the environment
# as BACKUP_<NAME>_* (see compose.yaml and .env.example), and its files land
# under <name>/ in the bucket. Output goes to the container log.
#
# To add a job: add a line here, add its BACKUP_<NAME>_* block to compose.yaml
# and .env, attach the container to that database's network in compose.yaml,
# then `sudo docker compose up -d --build`.

# min hour day month weekday  command

# Inngest's Postgres, nightly (02:17 or 03:17 in Virginia).
17 7 * * * backup-postgres inngest >/proc/1/fd/1 2>&1

# The app's own database, hourly, once it lives on this server:
# 43 * * * * backup-postgres supabase >/proc/1/fd/1 2>&1
