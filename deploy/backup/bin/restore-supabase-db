#!/usr/bin/env bash
# restore-supabase-db <backup> [--yes]
#
# Replaces the contents of the Supabase database with one backup made by the
# `supabase` job. <backup> is a path as `rclone lsf -R vault:supabase/` prints
# it, for example  2026/11/supabase-20261110T074300Z.dump
#
# STOP EVERY SUPABASE SERVICE EXCEPT THE DATABASE FIRST (README.md has the
# command). They hold connections, and a table cannot be replaced under them.
#
# It works on the database as it is and on a brand-new empty one alike, and
# does four things, in this order, because each was needed when it was
# rehearsed:
#
#   1. Roles. A dump holds one database; roles and the settings stored on
#      them belong to the cluster. The .roles.sql file saved beside the dump
#      is applied first. On a new database this also creates the one role the
#      Realtime service normally makes for itself, which the dump refers to.
#      "already exists" for every other role is expected and ignored.
#   2. Default grants. A Supabase database grants anon and authenticated
#      access to whatever is created in `public`. pg_restore re-creates every
#      table and function, so each would come back with those grants added to
#      its own, including the ones the app revoked on purpose. The restoring
#      role's default grants are cleared first; the dump carries the real
#      ones and puts them back at the end.
#   3. Partitions. pg_restore --clean cannot take a partitioned table apart
#      in place ("cannot drop inherited constraint"), and Realtime makes a
#      partition of realtime.messages for each day by itself, so even a new
#      database has some. Every partition is dropped first; the dump brings
#      back the ones it holds, and Realtime makes its own again.
#   4. pg_restore --clean --if-exists, as supabase_admin, then ANALYZE.
#
# Settings: the BACKUP_SUPABASE_PG* variables of the backup job.
set -euo pipefail

job=supabase
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [restore ${job}] $*"; }
die() {
	log "FAILED: $*"
	exit 1
}

backup=""
yes=false
for arg in "$@"; do
	case "$arg" in
		--yes) yes=true ;;
		-*) die "unknown argument: $arg" ;;
		*) backup="$arg" ;;
	esac
done
[ -n "$backup" ] || die "usage: restore-supabase-db <backup> [--yes]   (list them: rclone lsf -R --files-only vault:${job}/ | grep dump | sort)"
backup="${backup#vault:}"
backup="${backup#"${job}"/}"
case "$backup" in *.dump) ;; *) die "name the .dump file, not ${backup}" ;; esac

export PGHOST="${BACKUP_SUPABASE_PGHOST:?BACKUP_SUPABASE_PGHOST is not set}"
export PGPORT="${BACKUP_SUPABASE_PGPORT:-5432}"
export PGUSER="${BACKUP_SUPABASE_PGUSER:?BACKUP_SUPABASE_PGUSER is not set}"
export PGPASSWORD="${BACKUP_SUPABASE_PGPASSWORD:?BACKUP_SUPABASE_PGPASSWORD is not set}"
export PGDATABASE="${BACKUP_SUPABASE_PGDATABASE:?BACKUP_SUPABASE_PGDATABASE is not set}"
export PGCONNECT_TIMEOUT=15

magic="$(rclone cat --count 5 "vault:${job}/${backup}" 2>/dev/null || true)"
[ "$magic" = "PGDMP" ] || die "vault:${job}/${backup} is not there, or is not a Postgres dump"
roles="${backup%.dump}.roles.sql"
rclone lsf "vault:${job}/${roles}" >/dev/null 2>&1 || die "the roles file vault:${job}/${roles} is missing"

# Every other connection to this database, whatever role it uses: Realtime,
# for one, connects as supabase_admin, the same role as this script.
others="$(psql -X -At -c "select count(*) from pg_stat_activity where datname = current_database() and pid <> pg_backend_pid() and backend_type = 'client backend'")" \
	|| die "cannot reach the database"
if [ "$others" != 0 ]; then
	psql -X -At -c "select '  ' || who || ' x' || n from (select usename || ' (' || coalesce(nullif(application_name, ''), 'no name') || ')' as who, count(*) as n from pg_stat_activity where datname = current_database() and pid <> pg_backend_pid() and backend_type = 'client backend' group by 1) c order by 1" >&2 || true
	die "${others} connection(s) from other services are open: stop every Supabase service except db first"
fi

if ! $yes; then
	[ -t 0 ] || die "this replaces the whole database; pass --yes to confirm when not typing at a terminal"
	printf 'This REPLACES everything in database %s on %s with %s. Type yes to go on: ' "$PGDATABASE" "$PGHOST" "$backup"
	read -r answer
	[ "$answer" = yes ] || die "not confirmed"
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

log "1/4 roles and their settings"
rclone cat "vault:${job}/${roles}" >"$work/roles.sql" || die "could not read the roles file"
psql -X -q -f "$work/roles.sql" >"$work/roles.log" 2>&1 || true
unexpected="$(grep -E 'ERROR|FATAL' "$work/roles.log" | grep -v 'already exists' || true)"
[ -z "$unexpected" ] || { echo "$unexpected" >&2; die "applying the roles failed"; }

log "2/4 clearing the default grants of ${PGUSER}"
psql -X -q -v ON_ERROR_STOP=1 >/dev/null <<'SQL' || die "could not clear the default grants"
select pg_catalog.format(
         'alter default privileges for role %I in schema %I revoke all on %s from %s',
         pg_catalog.pg_get_userbyid(d.defaclrole), n.nspname,
         case d.defaclobjtype
           when 'r' then 'tables' when 'S' then 'sequences'
           when 'f' then 'functions' when 'T' then 'types'
         end,
         pg_catalog.string_agg(distinct
           case when a.grantee = 0 then 'public'
                else pg_catalog.quote_ident(pg_catalog.pg_get_userbyid(a.grantee)) end, ', '))
from pg_catalog.pg_default_acl d
join pg_catalog.pg_namespace n on n.oid = d.defaclnamespace
cross join lateral pg_catalog.aclexplode(d.defaclacl) a
where pg_catalog.pg_get_userbyid(d.defaclrole) = current_user
  and d.defaclobjtype in ('r', 'S', 'f', 'T')
group by d.defaclrole, n.nspname, d.defaclobjtype
\gexec
SQL

log "3/4 dropping partitions (the backup brings its own back)"
psql -X -q -v ON_ERROR_STOP=1 >/dev/null <<'SQL' || die "could not drop the partitions"
set client_min_messages = warning;
select pg_catalog.format('drop table if exists %I.%I cascade', n.nspname, c.relname)
from pg_catalog.pg_class c
join pg_catalog.pg_namespace n on n.oid = c.relnamespace
where c.relispartition and c.relkind in ('r', 'p')
order by 1
\gexec
SQL

log "4/4 restoring ${backup}"
started=$SECONDS
# Decrypted as it is read, straight into pg_restore: nothing is written to disk.
rclone cat "vault:${job}/${backup}" | pg_restore --clean --if-exists --no-password --dbname "$PGDATABASE" >"$work/restore.log" 2>&1 || true
errors="$(grep -c 'pg_restore: error' "$work/restore.log" || true)"
if [ "$errors" != 0 ]; then
	grep -A 2 'pg_restore: error' "$work/restore.log" | head -n 40 >&2
	die "pg_restore reported ${errors} error(s): the database is partly restored. Fix the cause and run this again; it starts from scratch each time."
fi
psql -X -q -c "set client_min_messages = error" -c "analyze" >/dev/null || true
log "restored in $((SECONDS - started))s: $(psql -X -At -c "select count(*) from auth.users") users, $(psql -X -At -c "select count(*) from pg_tables where schemaname = 'public'") tables in public"
log "done. Start the services again, then restore the files if they were lost too (restore-supabase-storage)."
