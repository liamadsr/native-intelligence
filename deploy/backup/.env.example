# Copy to .env in this folder on the server. Owner root, mode 600, never in git:
#   sudo install -m 600 -o root -g root .env.example .env && sudo nano .env
# Keep a copy of the filled-in file in the password manager: without
# BACKUP_PASSWORD and BACKUP_SALT the backups cannot be read by anyone.

# --- Where the files go: Backblaze B2 -------------------------------------

# An application key limited to the one bucket (B2 console, Application Keys),
# with read and write access. keyID and applicationKey, as B2 shows them once.
B2_KEY_ID=
B2_APPLICATION_KEY=
# The bucket's name. Private, created by hand. B2 bucket names are unique
# across all of B2: native-intelligence-backups, or that plus a suffix.
B2_BUCKET=

# --- What they are encrypted with -----------------------------------------

# Every file is encrypted in the container before upload (rclone crypt).
# Both values are needed to read a backup, on this server or anywhere else.
# Generate each: openssl rand -base64 32
BACKUP_PASSWORD=
BACKUP_SALT=

# --- Job: inngest ----------------------------------------------------------

# The same value as POSTGRES_PASSWORD in ../inngest/.env.
BACKUP_INNGEST_PGPASSWORD=

# Dead-man switch: a URL that is requested after every good backup. Point it
# at a check that alerts when no request arrives for a little over a day.
# Leave empty to run without one.
BACKUP_INNGEST_PING_URL=

# Backups older than this many days are deleted after each good run.
# Optional, default 30. 0 keeps everything.
#BACKUP_INNGEST_RETENTION_DAYS=

# --- Supabase: both jobs off until this line is set ------------------------

# Uncomment once the Supabase stack (../supabase) runs on this server, then
# `sudo docker compose up -d --build`. It layers compose.supabase.yaml on
# compose.yaml, which joins this container to the Supabase network and turns
# on the two jobs below. Without it the container never hears of Supabase.
#COMPOSE_FILE=compose.yaml:compose.supabase.yaml

# --- Job: supabase (the database, every hour) -------------------------------

# The same value as POSTGRES_PASSWORD in ../supabase/stack/.env.
BACKUP_SUPABASE_PGPASSWORD=

# Requested after every good run. Point it at a check that expects a request
# every hour and alerts after about two hours of silence.
BACKUP_SUPABASE_PING_URL=

# How many backups are kept: the newest this many, and the newest of each of
# this many days. Optional, defaults 48 and 30. Both 0 keeps every backup.
#BACKUP_SUPABASE_KEEP_HOURLY=
#BACKUP_SUPABASE_KEEP_DAILY=

# --- Job: supabase-storage (the stored files, every night) ------------------

# The host name in SUPABASE_PUBLIC_URL of ../supabase/stack/.env, without
# https:// (for example sb.nativeintelligence.dev). Storage only answers S3
# requests made for that name; inside Docker it is pointed at the gateway.
BACKUP_SUPABASE_STORAGE_HOST=

# The same values as REGION, S3_PROTOCOL_ACCESS_KEY_ID and
# S3_PROTOCOL_ACCESS_KEY_SECRET in ../supabase/stack/.env.
BACKUP_SUPABASE_STORAGE_S3_REGION=
BACKUP_SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
BACKUP_SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=

# Requested after every good run. A check that expects one a day.
BACKUP_SUPABASE_STORAGE_PING_URL=

# How many days a file that was deleted or replaced in Storage stays in the
# backup, counted from the night the job found it gone. Optional, default 30.
# 0 keeps them for ever.
#BACKUP_SUPABASE_STORAGE_REMOVED_DAYS=
