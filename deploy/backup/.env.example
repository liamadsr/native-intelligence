# Copy to .env in this folder on the server. Owner root, mode 600, never in git:
#   sudo install -m 600 -o root -g root .env.example .env && sudoedit .env
# Keep a copy of the filled-in file in the password manager: without
# BACKUP_PASSWORD and BACKUP_SALT the backups cannot be read by anyone.

# --- Where the files go: Backblaze B2 -------------------------------------

# An application key limited to the one bucket (B2 console, Application Keys),
# with read and write access. keyID and applicationKey, as B2 shows them once.
B2_KEY_ID=
B2_APPLICATION_KEY=
# The bucket's name. Private, created by hand. B2 bucket names are unique
# across all of B2: native-intelligence-backups, or that plus a suffix.
B2_BUCKET=

# --- What they are encrypted with -----------------------------------------

# Every file is encrypted in the container before upload (rclone crypt).
# Both values are needed to read a backup, on this server or anywhere else.
# Generate each: openssl rand -base64 32
BACKUP_PASSWORD=
BACKUP_SALT=

# --- Job: inngest ----------------------------------------------------------

# The same value as POSTGRES_PASSWORD in ../inngest/.env.
BACKUP_INNGEST_PGPASSWORD=

# Dead-man switch: a URL that is requested after every good backup. Point it
# at a check that alerts when no request arrives for a little over a day.
# Leave empty to run without one.
BACKUP_INNGEST_PING_URL=

# Backups older than this many days are deleted after each good run.
# Optional, default 30. 0 keeps everything.
#BACKUP_INNGEST_RETENTION_DAYS=
