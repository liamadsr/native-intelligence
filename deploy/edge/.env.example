# Copy to .env in this folder on the server. Owner root, mode 600, never in git:
#   sudo install -m 600 -o root -g root .env.example .env && sudo nano .env

# Where the Supabase host forwards to, with the scheme and no trailing slash.
# Today: the hosted project's URL (https://<project ref>.supabase.co).
# Later: the self-hosted stack on this server.
SUPABASE_UPSTREAM=

# Once the Supabase stack exists on this server (../README.md, step 14), and
# before SUPABASE_UPSTREAM is pointed at it: uncomment this line. It puts
# Caddy on the network it shares with the Supabase gateway and with nothing
# else. Leave it commented until then: with it, Caddy does not start unless
# that network exists.
#COMPOSE_FILE=compose.yaml:compose.supabase.yaml

# The two public hostnames. Leave these out to use the defaults
# (inngest.nativeintelligence.dev and sb.nativeintelligence.dev). Both need a
# DNS record pointing at this server before Caddy starts, or it cannot get
# their certificates.
#INNGEST_HOST=
#SUPABASE_HOST=
