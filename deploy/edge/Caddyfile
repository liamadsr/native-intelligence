# The public door for everything that is HTTP: ports 80 and 443. The one other
# thing published on this server is LiveKit's media (UDP 7882, TCP 7881, and,
# once set up, TURN over TLS on 443 of the server's second address: ../livekit),
# which is not HTTP and goes straight to LiveKit.
#
# Hosts named from the environment (see compose.yaml and .env.example):
#   INNGEST_HOST   an allowlist in front of the self-hosted Inngest server
#   SUPABASE_HOST  a pass-through to SUPABASE_UPSTREAM
#   APP_HOSTS      the app (../app), once it runs on this server
#   LIVEKIT_HOST   LiveKit's signalling, for calls (../livekit)
#   LIVEKIT_TURN_HOST  LiveKit's TURN name: its certificate only (served elsewhere)
#   CLOUD_BROWSER_HUB_DOMAIN  one name per cloud browser under it, when they run
#                  on our own sandbox server (CLOUD_BROWSER_TRAFFIC_UPSTREAM)
#
# Check a change before reloading:
#   sudo docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile
#   sudo docker compose exec caddy caddy reload   --config /etc/caddy/Caddyfile
{
	# Caddy's own log: everything that is not an access log. When an upstream
	# is down, the error Caddy logs carries the whole request, so the secrets
	# kept out of the two access logs below are scrubbed here as well: the
	# Inngest event key in the path, the Supabase key and one-time tokens in
	# the query string, and any other long run of key characters.
	log default {
		format filter {
			wrap json
			fields {
				request>headers>Apikey delete
				request>uri multi_regexp {
					regexp "^/e/[^/?]+" "/e/REDACTED"
					regexp "([?&](apikey|token|access_token|refresh_token|code)=)[^&]*" "${1}REDACTED"
					regexp "[A-Za-z0-9_-]{32,}" "REDACTED"
				}
			}
		}
	}

	# Caddy has TCP 80 and 443 only, so no HTTP/3 (which is UDP 443). UDP 443
	# stays closed: LiveKit's media has a UDP port of its own (7882).
	servers {
		protocols h1 h2
		# Room for a request's headers. Without this line Caddy refuses a request
		# whose headers pass about 16 KB in all with its own 431 (over HTTP/2 an
		# HTML one, with no log line), and a chat turn's cookies, run token and
		# context together pass that. The app proxy and Node behind it allow the
		# same (app/proxy/Caddyfile, app/entrypoint.sh).
		max_header_size 64KB
		timeouts {
			read_header 1m
			idle 15m
		}
	}

	# On-demand certificates, used by the cloud browsers' block at the end and
	# by nothing else: only a site with `tls { on_demand }` gets a certificate
	# at the first handshake for a name, and every other site here keeps its
	# ordinary certificates, obtained at start. Before asking the certificate
	# authority for a name, Caddy asks the app (a GET with ?domain=<name>; a 2xx
	# is yes, anything else, a redirect or no answer within 10 s is no), the same
	# way it reaches the app's own site: the stack's proxy over ni-edge. While
	# the app is down no new name gets a certificate; names that have one keep
	# being served from it.
	on_demand_tls {
		ask http://ni-app-proxy:8080/api/internal/cloud-browser/tls-ask
	}
}

# Everything a proxied request needs. Caddy already sets X-Forwarded-For,
# X-Forwarded-Proto and X-Forwarded-Host and drops any a client sent.
(proxy) {
	header_up X-Real-IP {remote_host}

	# Write every chunk to the client as it arrives: streamed responses and
	# server-sent events are never held back. WebSockets pass through as is.
	flush_interval -1

	transport http {
		dial_timeout 30s
		# An upstream may take 15 minutes to start answering, and may go
		# quiet for 15 minutes in the middle of a body.
		response_header_timeout 15m
		read_timeout 15m
		write_timeout 15m
	}
}

# ---------------------------------------------------------------------------
# Inngest
#
# The dashboard, its GraphQL API (/v0/gql), /metrics, /debug (the Go profiler)
# and the MCP endpoint have no login, so this host is an allowlist. What is
# let through is what an app's Inngest SDK (inngest 4.0.0, serving over HTTP)
# calls on the server, and each of those checks the event key or the signing
# key itself. Everything else answers 404 here and never reaches Inngest.
# ../README.md has the list with where each path comes from, and the SDK
# paths that are deliberately left closed.
#
# Each rule matches the method and the cleaned path, then rebuilds the path it
# forwards from what matched, so Inngest only ever sees one of the exact
# shapes below (no doubled slashes, dot segments or escapes).
# ---------------------------------------------------------------------------
{$INNGEST_HOST:inngest.nativeintelligence.dev} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The event key is part of the path. Keep it out of the logs:
				# the segment after /e/, and any other run of 32 or more key
				# characters (a key sent on an odd path; run ids are 26).
				request>uri multi_regexp {
					regexp "^/e/[^/?]+" "/e/REDACTED"
					regexp "[A-Za-z0-9_-]{32,}" "REDACTED"
				}
			}
		}
	}

	# Send events: inngest.send() and step.sendEvent().
	@events {
		method POST
		path_regexp events ^/e/([A-Za-z0-9_-]+)$
	}
	handle @events {
		rewrite * /e/{re.events.1}
		reverse_proxy ni-inngest:8288 {
			import proxy
		}
	}

	# Sync: the app registers its functions when it is asked to (a PUT to its
	# serve endpoint, from the sync loop, or from the server while a registered
	# app is in an error state).
	@register {
		method POST
		path /fn/register
	}
	handle @register {
		rewrite * /fn/register
		reverse_proxy ni-inngest:8288 {
			import proxy
		}
	}

	# A run whose steps or events are too large to send with the request:
	# the SDK fetches them instead.
	@run_state {
		method GET
		path_regexp run_state ^/v0/runs/([0-9A-Za-z]+)/(actions|batch)$
	}
	handle @run_state {
		rewrite * /v0/runs/{re.run_state.1}/{re.run_state.2}
		reverse_proxy ni-inngest:8288 {
			import proxy
		}
	}

	# Checkpointing (on by default in SDK v4): the app reports each finished
	# step while the request that runs the function is still open.
	@checkpoint {
		method POST
		path_regexp checkpoint ^/v1/checkpoint/([0-9A-Za-z]+)/async$
	}
	handle @checkpoint {
		rewrite * /v1/checkpoint/{re.checkpoint.1}/async
		reverse_proxy ni-inngest:8288 {
			import proxy
		}
	}

	handle {
		respond 404
	}
}

# ---------------------------------------------------------------------------
# Supabase
#
# A plain pass-through to SUPABASE_UPSTREAM: today the hosted project's URL,
# later the self-hosted stack on this server. The Host header is rewritten to
# the upstream's own name, which a hosted project needs to route the request.
# ---------------------------------------------------------------------------
{$SUPABASE_HOST:sb.nativeintelligence.dev} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The project's API key travels in a header on every request
				# and in the query string of the Realtime WebSocket, and auth
				# links carry one-time tokens.
				request>headers>Apikey delete
				request>uri query {
					replace apikey REDACTED
					replace token REDACTED
					replace access_token REDACTED
					replace refresh_token REDACTED
					replace code REDACTED
				}
			}
		}
	}

	reverse_proxy {$SUPABASE_UPSTREAM} {
		import proxy

		# The bare host name, as a browser would send it ({upstream_hostport}
		# would add ":443"). It matches the name the upstream's certificate
		# is checked against.
		header_up Host {http.reverse_proxy.upstream.host}
	}
}

# ---------------------------------------------------------------------------
# The app
#
# Every host name in APP_HOSTS (separated by spaces, in .env; a comma with no
# space after it makes Caddy refuse this whole file) goes to the app
# stack's own proxy (../app/proxy/Caddyfile), which sends each path on to web,
# the worker or an agent. Only that proxy is on ni-edge; the app's containers
# are not. A name starting with www. is sent to the same name without it, as
# the app's earlier host did; list it here all the same, so that it gets a
# certificate.
#
# Until the app runs on this server APP_HOSTS is unset, and this block is
# plain HTTP for app.invalid, a name no request carries: nothing is served and
# no certificate is asked for.
# ---------------------------------------------------------------------------
{$APP_HOSTS:http://app.invalid} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Sign-in links, OAuth returns and some webhooks carry codes
				# and tokens in the query string or the path. Cookies and
				# Authorization headers are left out of Caddy's logs anyway.
				request>uri multi_regexp {
					regexp "([?&](apikey|token|access_token|refresh_token|code|state|key|secret|signature|sig)=)[^&]*" "${1}REDACTED"
					regexp "[A-Za-z0-9_-]{32,}" "REDACTED"
				}
			}
		}
	}

	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} 308

	# The question the edge asks before a cloud browser's certificate (the
	# global on_demand_tls above) is the edge's alone: from outside it is no
	# page at all.
	respond /api/internal/cloud-browser/tls-ask* 404

	reverse_proxy ni-app-proxy:8080 {
		import proxy

		# The stack's proxy names the container that answered, for its own
		# test. Not for the public.
		header_down -X-NI-Upstream
	}
}

# ---------------------------------------------------------------------------
# LiveKit
#
# The signalling of calls: the WebSocket a browser opens (/rtc), the server API
# the app calls (/twirp/...), and the WebSocket agents connect to (/agent).
# LiveKit checks a token signed with its API key on every one of them. The media
# itself does not come through here: it goes to LiveKit's own UDP and TCP ports.
#
# Caddy reaches LiveKit over ni-livekit-edge, a network the two share with
# nothing else (compose.livekit.yaml). Until LIVEKIT_HOST is set this block is
# plain HTTP for livekit.invalid, a name no request carries, like the app's
# block above.
# ---------------------------------------------------------------------------
{$LIVEKIT_HOST:http://livekit.invalid} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The browser's join token travels in the WebSocket's query
				# string; the API's in the Authorization header, which Caddy
				# leaves out of its logs anyway.
				request>uri query {
					replace access_token REDACTED
					replace token REDACTED
				}
			}
		}
	}

	reverse_proxy ni-livekit:7880 {
		import proxy

		# A reload of this file (caddy reload) would otherwise close every
		# call's signalling WebSocket at once. With this, the connections open
		# at the reload stay up on the old configuration for up to 4 hours,
		# longer than a call. Replacing the container (`up -d` when .env or a
		# compose file changed) still closes them all: the browsers reconnect
		# by themselves, and the media, which does not pass through Caddy,
		# keeps flowing meanwhile.
		stream_close_delay 4h
	}
}

# ---------------------------------------------------------------------------
# LiveKit's TURN name: a certificate, and nothing served
#
# TURN over TLS runs on port 443 of the server's SECOND address, held by
# LiveKit's own TLS terminator (../livekit/compose.turn.yaml), not by Caddy,
# which keeps 443 on the first (EDGE_PUBLIC_IP in compose.yaml). The name's DNS
# record points at the second address. This block is here only so that Caddy
# obtains and renews that name's certificate, which the terminator reads from
# Caddy's volume (caddy-data, the name's own folder only).
#
# - Let's Encrypt alone, by name: the certificate then always lands in the same
#   folder (acme-v02.api.letsencrypt.org-directory/<name>), which is the one the
#   terminator mounts. With Caddy's default issuers a failure at Let's Encrypt
#   would fall back to another CA, into another folder, and the terminator would
#   keep serving the old certificate until it ran out.
# - Over port 80 only (the HTTP challenge): port 80 is Caddy's on every address,
#   the second included, while 443 there is the terminator's, which cannot
#   answer the TLS-ALPN challenge.
# - Anything that reaches Caddy for the name anyway (443 on the first address,
#   or plain HTTP, which Caddy redirects) is answered 404.
#
# Until LIVEKIT_TURN_HOST is set this block is plain HTTP for turn.invalid, a
# name no request carries: Caddy manages no certificate for an http:// site, so
# nothing is asked of Let's Encrypt.
# ---------------------------------------------------------------------------
{$LIVEKIT_TURN_HOST:http://turn.invalid} {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	respond 404
}

# ---------------------------------------------------------------------------
# The cloud browsers on our own sandbox server
#
# One public name per browser: https://<sandbox id>.<CLOUD_BROWSER_HUB_DOMAIN>,
# which the app hands out when its browsers run on our own sandbox server
# (CLOUD_BROWSER_BACKEND=runtime in ../app/.env). Each goes to that sandbox's
# hub (port 4000 inside it, its live view and its exit's WebSocket), through
# the runtime's traffic port over the private tunnel
# (CLOUD_BROWSER_TRAFFIC_UPSTREAM, the tunnel address and 3002).
#
# Certificates are obtained on demand, one per name, at the first handshake
# for it, and only for a name the app says is one of its browsers (the global
# on_demand_tls above). Not a wildcard certificate: that needs the DNS
# challenge, so a key for the DNS provider on this server, and the DNS
# provider's keys are not limited to DNS (../README.md, "The cloud browser").
#
# What is let through, and how:
# - Only a name whose first label has the shape of the runtime's sandbox ids
#   (20 lowercase letters and digits), and only as the name the connection's
#   certificate was made for: the TLS server name must be the Host itself, and
#   the Host is one label under the hub's domain (this site's address, matched
#   label by label, its dots literal). No regular expression holds the domain:
#   Caddy puts {$...} values into the text as they are, so a dot there would
#   match any character. Anything else is answered 404 here and never reaches
#   the tunnel.
# - Only port 4000 of that sandbox, whatever the client sends: the routing
#   headers are set here, and the runtime's traffic port takes them only when
#   the Host it is sent is an address (packages/shared/pkg/proxy/host.go in the
#   runtime), so Host becomes the upstream's address and port.
# - The client's address goes in X-Real-IP, replacing any the client sent. The
#   runtime's traffic port drops X-Forwarded-For on its way to the sandbox (it
#   is a Go reverse proxy with a Rewrite function that sets none), so the hub
#   reads X-Real-IP there.
# - WebSockets pass, and are not cut for being quiet: no read or write limit
#   on this transport, unlike the snippet above. A reload keeps the open ones
#   on the old configuration for up to 4 hours (as LiveKit's block does).
#
# Until CLOUD_BROWSER_HUB_DOMAIN is set this block is for
# *.cloud-browser.invalid, names no request carries: a handshake that names one
# anyway makes Caddy ask the app, which says no, and nothing is issued.
# ---------------------------------------------------------------------------
https://*.{$CLOUD_BROWSER_HUB_DOMAIN:cloud-browser.invalid} {
	tls {
		on_demand
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The hub's viewer tokens travel in headers or in the first
				# WebSocket message; anything token-like in the address is
				# kept out all the same.
				request>uri multi_regexp {
					regexp "([?&](token|access_token|key|secret|signature|sig)=)[^&]*" "${1}REDACTED"
					regexp "[A-Za-z0-9_-]{32,}" "REDACTED"
				}
			}
		}
	}

	@hub {
		vars {http.request.tls.server_name} {http.request.host}
		# One label of lower-case letters and digits. No exact length: the
		# runtime's ids are an "i" and twenty characters today (21, seen on the
		# first real browser; a pattern for exactly 20 refused every request).
		# What makes a name a real browser's is the app's yes before its
		# certificate, not this pattern.
		vars_regexp hub {http.request.tls.server_name} ^([a-z0-9]{16,40})\.
	}
	handle @hub {
		reverse_proxy {$CLOUD_BROWSER_TRAFFIC_UPSTREAM:127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up E2b-Sandbox-Id {re.hub.1}
			header_up E2b-Sandbox-Port 4000
			header_up X-Real-IP {remote_host}
			# The runtime's per-sandbox traffic token is the app's to send, never a client's.
			header_up -E2b-Traffic-Access-Token

			flush_interval -1
			stream_close_delay 4h

			transport http {
				dial_timeout 10s
			}
		}
	}

	handle {
		respond 404
	}
}
