# What the app containers in the container test (compose.yaml in this folder) read.
# Copy to deploy/app/smoke/.env (git ignores it) and fill in; every web, worker, agent
# and cron container gets all of it. The server's own settings file is a different
# one: ../.env.example.
# smoke.sh does not use this file: it makes up its own values for each run.
#
# With real values this stack acts on real data. Its cron container stays a dry run
# (compose.yaml) so that it does not run the schedule a second time beside production.
#
# This is the short list the roles need to start and reach each other. The app's
# full list is web/.env.example; anything from there can go here too.

# Bearer the cron role sends to /api/cron/*. The web role answers 503 without it.
CRON_SECRET=
# The root internal secret between the app and the agents.
RUN_SKILL_INTERNAL_SECRET=
# The worker's /api/inngest answers 500 without a signing key. The containers refuse
# to start with Inngest or eve in development mode (INNGEST_DEV=1, EVE_DEV=1), so do
# not copy those from web/.env.example.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# The self-hosted Inngest server (../README.md, step 13): its public address, and
# INNGEST_DEV=0, which keeps the SDK out of development mode (see above).
INNGEST_BASE_URL=
INNGEST_DEV=0
# Supabase. `docker compose build web` also reads the URL, the anon key and the
# project ref from this file and compiles them into the web role, so build again
# after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only when the URL above is not the address the project's sessions were made under
# (a project moved here from <ref>.supabase.co): that ref. The session cookie keeps
# its name, so nobody is signed out by the move. The web role has it compiled in and
# the agents read it when they start, so both must get the same value. Leave it
# empty for a project that began on the URL above.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
# Model calls: the agents reach the AI Gateway with this key. Off Vercel there is no
# OIDC token to fall back on.
AI_GATEWAY_API_KEY=
