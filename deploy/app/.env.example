# What the app containers in compose.yaml read. Copy to deploy/app/.env (git ignores
# it) and fill in; every web, worker, agent and cron container gets all of it.
# smoke.sh does not use this file: it makes up its own values for each run.
#
# With real values this stack acts on real data. Its cron container stays a dry run
# (compose.yaml) so that it does not run the schedule a second time beside Vercel.
#
# This is the short list the roles need to start and reach each other. The app's
# full list is web/.env.example; anything from there can go here too.

# Bearer the cron role sends to /api/cron/*. The web role answers 503 without it.
CRON_SECRET=
# The root internal secret between the app and the agents.
RUN_SKILL_INTERNAL_SECRET=
# The worker's /api/inngest answers 500 without a signing key. The containers refuse
# to start with Inngest or eve in development mode (INNGEST_DEV=1, EVE_DEV=1), so do
# not copy those from web/.env.example.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Supabase. `docker compose build web` also reads the URL and the anon key from
# this file and compiles them into the web role, so build again after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Model calls: the agents reach the AI Gateway with this key. Off Vercel there is no
# OIDC token to fall back on.
AI_GATEWAY_API_KEY=
