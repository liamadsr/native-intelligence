# The app's settings on the server: every web, worker, agent and cron container
# reads all of this file, and `docker compose build` takes the values `next build`
# compiles in from it too. Owner root, mode 600, never in git; a copy in the
# password manager. Made from this file on the server:
#
#   sudo install -m 600 -o root -g root .env.example .env
#
# then filled in from your own machine by pull-settings.sh (it brings what the app's
# earlier host will give out, copies what this server already holds, and lists the
# rest), and set-secret.sh for what is left. ../README.md step 20 has the order.
# Every line must stay: the tools only change values of lines that exist.

# --- 1. This stack ---------------------------------------------------------------

# 1 makes this copy the live one: the scheduler runs the jobs, and web and worker
# may register the app's functions with Inngest. Anything else (empty) is a
# rehearsal: the jobs are only logged and the app cannot be registered, so it can
# run beside the app's earlier host on the same data. entrypoint.sh has the detail.
NI_LIVE=

# Forwards people who open a page on dial8.ai (or www.) to the same path on
# nativeintelligence.dev: 307 to start with, 308 once it is for good; empty or anything
# else is off. Read when the containers start, so `sudo ./deploy.sh --no-build` turns it
# on or off. It does nothing while NEXT_PUBLIC_APP_URL is still on dial8.ai.
# web/src/lib/old-domain-forward.ts has what is never forwarded, and why.
# pull-settings.sh copies the app's earlier host's value when that host has one.
NI_FORWARD_OLD_DOMAIN=

# The cloud browser's relay host, as the app's earlier host derived it for itself:
# https://browser-relay.<the domain in NEXT_PUBLIC_APP_URL>.
CLOUD_BROWSER_RELAY_ORIGIN=

# The cloud browser's sandboxes still run on the app's earlier host. There the app
# logged in with that platform's own deployment token; here it has none, so: an
# access token of that account, scoped to the team, and the ids of the team and the
# project the sandboxes belong to (web/src/lib/cloud-browser/config.ts). All three
# or none.
# The same three run the coding agent's sandboxes on that service
# (web/agents/coding-agent/sandbox.ts); without them its coding runs cannot work.
# The image is built with them (deploy.sh hands them to the build as secrets, never
# as build arguments): after changing one, `sudo ./deploy.sh`, not --no-build.
SANDBOX_ACCESS_TOKEN=
SANDBOX_TEAM_ID=
SANDBOX_PROJECT_ID=

# The coding agent's third way: our own sandbox runtime on the sandbox server
# (../sandbox/README.md). It may be set beside the three above: the coding agent then
# uses it and ignores them, and they stay for the cloud browser until that moves.
# Empty: nothing uses it. Production has had it set since 2026-11-12
# (../README.md, "The coding agent", says what is proven on it).
# The runtime's API and the traffic to its sandboxes, both over the private tunnel
# (../sandbox/README.md, "The tunnel"): http://<the runtime's tunnel address>:3000
# and :3002. Both or neither. The image is built with them (as build arguments:
# they are not secret): after changing one, `sudo ./deploy.sh`, not --no-build.
SANDBOX_RUNTIME_API_URL=
SANDBOX_RUNTIME_TRAFFIC_URL=
# The template its sandboxes start from, built on the sandbox server; empty:
# ni-coding-agent.
SANDBOX_RUNTIME_TEMPLATE=
# The runtime's API key (e2b_ and hex), from the sandbox server's /opt/e2b/sdk.env,
# moved from that file into this one without being shown or printed on the way.
# Only the coding agent's container gets it, when it runs; no build ever sees it.
SANDBOX_RUNTIME_KEY=
# Read by web: the addresses the app's git gate accepts a coding run's git
# credential from, comma or space separated: the sandbox server's public IPv4 and
# IPv6. Set it together with the runtime's settings (the coding agent refuses to
# run there without it), and only then: while it is set, the hosted service's
# sandboxes, which come from other addresses, cannot clone or push. One entry
# that is not an address refuses every request. The public addresses, as the
# edge sees them: not the tunnel's. Before emptying it again, let the coding
# runs on our own runtime end: their credentials sit inside their sandboxes,
# and would be accepted from anywhere for as long as those runs live.
AGENT_RUN_GIT_GATE_ALLOWED_ADDRESSES=

# --- 2. Compiled into the web role by `next build` --------------------------------
# Changing one of these needs a new build (sudo ./deploy.sh). The first three are
# required. NEXT_PUBLIC_APP_URL is the app's public address: for a rehearsal, the
# test address; for production, production's.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SITE_URL=
APP_DOWNLOAD_URL=
APP_DOWNLOAD_URL_WINDOWS=

# --- 3. Read when the containers start --------------------------------------------
# The production settings of the app's earlier host, by the same names. Those it
# gives out, pull-settings.sh copies; those it keeps write-only, it lists for
# set-secret.sh. Some of these must keep exactly the value they have there, because
# what they sign or encrypt is already stored or held elsewhere: README.md in this
# folder says which.

# Background jobs (../inngest). The keys are copied from ../inngest/.env on this
# server; INNGEST_DEV=0 is required (the containers refuse development mode).
INNGEST_BASE_URL=
INNGEST_DEV=0
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# The database (../supabase).
SUPABASE_SERVICE_ROLE_KEY=
PROD_SUPABASE_URL=

# Between the app and its agents, and the scheduler.
CRON_SECRET=
RUN_SKILL_INTERNAL_SECRET=
AGENT_RUN_INTERNAL_SECRET=
CHAT_INTERNAL_SECRET=
BROWSER_INTERNAL_SECRET=
LOCAL_AGENT_TOKEN_SECRET=
OAUTH_STATE_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
UNSUBSCRIBE_SECRET=

# Models.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GATEWAY_USAGE_REPORTING=
GATEWAY_USER_TAGGING=
DEEPGRAM_API_KEY=
EXA_API_KEY=

# Search data for the SEO pages (keyword research, rank tracking, domain and
# backlink lookups, AI visibility): DataForSEO's "Base64" API credential (the
# base64 of login:password, from its API Access page). Paid per call, held to
# a monthly limit per workspace. Empty: those lookups are off and the pages say
# so; the site audit works without it.
DATAFORSEO_API_KEY=

# Audio and video calls, on this server's own LiveKit (../livekit, ../README.md
# step 23). All three or none; empty, calls are off. Never typed: make-keys.sh in
# ../livekit makes the key pair and writes the same pair into ../livekit/.env and
# here. LIVEKIT_URL is the address browsers connect to, wss:// and the name in
# LIVEKIT_HOST in ../edge/.env (wss://livekit.nativeintelligence.dev). The app's
# server reaches LiveKit's API at the same name.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# on once LiveKit's Egress runs (COMPOSE_PROFILES=egress in ../livekit/.env, and
# its test recording passed): the app then offers call notes. Empty: off, and the
# app does not ask for recordings. Egress keeps its storage settings itself; the
# app sends only a file path and reads the files through Storage.
LIVEKIT_EGRESS=
# on once the call recorder runs (COMPOSE_PROFILES with recorder in ../livekit/.env,
# ../README.md step 23, "The call recorder"): call notes are then the recorder's, and
# fill in while the call goes on. Empty: off (notes are Egress's, if LIVEKIT_EGRESS is on).
TEAM_CALL_RECORDER=
# The secret the recorder sends with every request to the app (its capture feed). Never
# typed: ../livekit/make-keys.sh makes it and writes the same value here and into
# ../livekit/.env. Empty: the feed is off.
CAPTURE_FEED_SECRET=

# The Studio (videos and ads). The secret the Studio worker (../studio) sends with every
# request to the app (/api/internal/studio/*): the same value as in ../studio/.env, and no
# other secret's. Empty: the worker is refused, so nothing is imported, rendered or exported
# (the Studio page still opens and edits).
STUDIO_WORKER_SECRET=
# Which workspaces may make narration (ElevenLabs) and generated shots (Higgsfield) on the
# provider accounts the Studio worker holds: workspace ids, comma-separated, or * for every
# workspace. The worker holds ONE account per provider, shared by every workspace it serves
# (per-workspace provider keys do not exist yet), so a listed workspace sees its voices and
# spends its credits. Empty: none (narration, generated shots and costs are off).
STUDIO_PROVIDER_WORKSPACES=
# Whether the Studio's code scenes (graphics the agent writes as React code) run here, on or off, and empty is off
# (turning them on needs STUDIO_CODE_SCENES=on in deploy/studio/.env too). They are off because a scene can still make
# a viewer's browser reach a host and the worker's render browser is not fenced from the worker
# (studio-worker/README.md, "Code scenes").
STUDIO_CODE_SCENES=

# Calls and texts.
GPT_LIVE_API_KEY=
GPT_LIVE_TRUNK_SECRET=
GPT_LIVE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Mail.
RESEND_API_KEY=
EMAIL_FROM=
GMAIL_PUBSUB_TOPIC=
GMAIL_WEBHOOK_TOKEN=
OUTLOOK_WEBHOOK_SECRET=

# Connections.
OAUTH_REDIRECT_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# "Continue with ChatGPT" (web/src/lib/chatgpt/config.ts): sign-in and the free
# tier on a person's own ChatGPT plan, with the partner client OpenAI registered
# for this app. Optional: empty, the option stays hidden. Read at start.
# The partner client's id (oaiapp_...).
CHATGPT_CLIENT_ID=
# Its secret.
CHATGPT_CLIENT_SECRET=
# The exact callback registered with that client. Empty: <the app's address>/auth/chatgpt/callback.
CHATGPT_REDIRECT_URI=
# Slack: our own Slack app, which the app talks to directly (web/src/lib/slack/config.ts).
# All four from the Slack app's settings page at Slack (Basic Information, App
# Credentials); all four or none: Slack is off while any is empty. Read at start.
# The app's id (A...): installs, events and clicks for any other app are refused.
SLACK_APP_ID=
# The app's client id (digits.digits) and client secret: the install's token exchange.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The app's signing secret: Slack signs every event and button click with it.
SLACK_SIGNING_SECRET=

# Billing.
STRIPE_SECRET_KEY=
STRIPE_AI_USAGE_METER_NAME=
STRIPE_AI_USAGE_PRICE_ID=

# The cloud browser.
CLOUD_BROWSER_BASE_SNAPSHOT_ID=
CLOUD_BROWSER_SIGNING_KEY=

# Switches and the rest.
ADMIN_EMAILS=
AGENT_AUTO_ATTEMPT_ENABLED=
AGE_OUT_ENABLED=
RECONCILER_ENABLED=
RUN_SKILL_LOCAL_DISPATCH_ENABLED=
SENTRY_ORG=
SENTRY_PROJECT=
