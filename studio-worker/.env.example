# The Studio worker's settings when run by hand (npm start reads the shell's environment,
# not this file: `set -a; . ./.env; set +a` first). Every one has a default; an empty
# value counts as unset. On the server they come from deploy/studio/.env.

# The app. `next dev` by default.
STUDIO_APP_URL=http://localhost:3000
# Sent with every request; the app's STUDIO_WORKER_SECRET must be the same. Outside
# production the worker uses `dev-studio-worker` when this is empty.
STUDIO_WORKER_SECRET=

# Which job kinds this process takes (comma separated; all by default):
# import, export, stills, thumbnail, transcribe, slides
STUDIO_WORKER_KINDS=
# Jobs at once (1). A render already uses STUDIO_RENDER_CONCURRENCY Chrome tabs.
STUDIO_WORKER_CONCURRENCY=
# How often it asks for work when idle, in ms (2000).
STUDIO_WORKER_POLL_MS=
# Its name on the jobs it claims (host-pid).
STUDIO_WORKER_ID=

# Scratch, the render bundle and the asset cache (<tmp>/studio-worker), and the
# cache's bound in bytes (5 GB).
STUDIO_WORK_DIR=
STUDIO_CACHE_BYTES=
# Chrome tabs per render (2).
STUDIO_RENDER_CONCURRENCY=
# A Chrome headless shell already on this machine (the executable, or a folder it is
# inside, such as another project's node_modules/.remotion/chrome-headless-shell).
# Empty: Remotion downloads its own once.
STUDIO_CHROME=

# The health answer on 127.0.0.1 (9092; 0 = none), and how long a running job may
# still take after SIGTERM, in ms (25000).
STUDIO_HEALTH_PORT=
STUDIO_SHUTDOWN_GRACE_MS=

# Deepgram, for `transcribe` (the fallback to the desktop app's own model). Without it
# that kind fails with a sentence saying so.
DEEPGRAM_API_KEY=

# Narration (the `voices` and `narration` jobs): ElevenLabs' key, on the workspace's own
# account. Set, the worker tells the app it can narrate (the editor shows "Rewrite
# voiceover", the agent's narration tools work); empty, it never asks for those jobs.
# Every paid request is one call, never retried, recorded in the Studio's cost ledger.
ELEVENLABS_API_KEY=
# ElevenLabs' API origin (https://api.elevenlabs.io): only a test's fake changes it.
ELEVENLABS_URL=

# Generated shots (the `shot-quote` and `shot` jobs): the higgsfield command-line tool,
# installed and signed in (`higgsfield auth login`) on the machine this worker runs on.
# Empty: `higgsfield` on PATH or in the usual places. The worker asks the tool for its
# account status at start and every five minutes; only while it answers, signed in, does
# it offer generated shots. No key: the tool's own sign-in is the account.
STUDIO_HIGGSFIELD_BIN=

# The motion check and the video review (the `motion` and `review` jobs): a Python with
# numpy and OpenCV (opencv-python-headless) that runs python/motion_analysis.py. Empty:
# `python3` on PATH. Asked once at start; when it can't import both, the worker offers
# neither check and never asks for those jobs.
STUDIO_ANALYSIS_PYTHON=
# The review reads on-screen text with tesseract when one is here (empty: `tesseract` on
# PATH); without it on-screen text is left out of the review, which says so.
STUDIO_ANALYSIS_TESSERACT=

# Sound design (the `sounds`, `sound-import`, `listen` and `sound-bank` jobs): an installed
# earshot (MIT, an outside project, at the reviewed commit README.md names: "Sound"), its
# folder holding its own `.venv`. The worker asks it for its presets at start and every five
# minutes; only while it answers does it offer `sound` (the editor's ♪ Sound menu, the agent's
# sound tools). Empty: no sound design. The container image does not include earshot yet.
STUDIO_EARSHOT_DIR=
# Threads earshot's listening models use (3).
EARSHOT_THREADS=
