# Rust / Cargo
src-tauri/target/
src-tauri/crates/*/target/

# macOS
.DS_Store
**/.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Swift Package Manager (sidecar builds)
**/.build/

# Debug logs
dial8-debug.log

# Tauri generated
src-tauri/gen/schemas/
# Per-command permission TOMLs autogenerated from build.rs's APP_COMMANDS
# (AppManifest). Regenerated on every build; the source of truth is APP_COMMANDS.
src-tauri/permissions/autogenerated/

# Release builds
dist/

# Updater signing keys (NEVER commit private key, public key is safe)
src-tauri/keys/dial8.key
!src-tauri/keys/dial8.key.pub

# Release credentials
.env.release

# HubSpot config file
hubspot.config.yml

# Claude Code session data (worktrees, local settings)
.claude/

# Sidecar build outputs (scripts/sidecars.sh convention)
src-tauri/sidecars/*/.out/

# Python bytecode (scripts/licenses/*.py)
__pycache__/
