{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Native Intelligence",
  "version": "0.2.103",
  "identifier": "ai.dial8.desktop",
  "build": {
    "frontendDist": "https://nativeintelligence.dev",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1560,
        "height": 920,
        "minWidth": 938,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self' https://nativeintelligence.dev https://*.nativeintelligence.dev https://dial8.ai https://*.dial8.ai https://*.supabase.co https://*.posthog.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://nativeintelligence.dev https://*.nativeintelligence.dev https://dial8.ai https://*.dial8.ai; style-src 'self' 'unsafe-inline' https://nativeintelligence.dev https://*.nativeintelligence.dev https://dial8.ai https://*.dial8.ai; img-src 'self' data: blob: https: asset:; connect-src 'self' ipc: http://ipc.localhost https: wss: asset:; font-src 'self' data: https:; media-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dial8desktop"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NjgyQjlBODBEMjU5MTgKUldRWVdkS0FtaXRvOWVQcUxTSWkxdjBYbFM3aUtyOUZzMUd2eWtCM2E5TE1Gc04vYmVHaTUybmkK",
      "endpoints": [
        "https://nativeintelligence.dev/api/desktop/update/{{target}}/{{arch}}/{{current_version}}",
        "https://dial8.ai/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
