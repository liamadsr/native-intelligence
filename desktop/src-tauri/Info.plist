<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Native Intelligence needs access to your microphone to record audio during meetings and voice notes.</string>
	<key>NSCameraUsageDescription</key>
	<string>Native Intelligence uses your camera for video calls with your team, only while you have it on in a call.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Native Intelligence captures system audio to record meeting participants, enabling speaker-separated transcripts.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Native Intelligence uses speech recognition to detect when you're speaking, enabling automatic segment splitting for accurate transcription.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Native Intelligence reads your Exchange calendar to show upcoming meetings and enable auto-recording.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Native Intelligence reads your Exchange calendar to show upcoming meetings and enable auto-recording.</string>
	<!-- Kept from the retired in-app browser for the app's own web view: an
	     email can show http:// images, and this lets them load INSIDE WEB
	     CONTENT only. It does NOT loosen App Transport Security for the app's own
	     network requests (NSAllowsArbitraryLoadsInWebContent is scoped to
	     WKWebView content). Drop it once mail images are proxied or upgraded. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- URL schemes. ⚠️ Declaring CFBundleURLTypes here REPLACES the array Tauri
	     generates from tauri.conf.json's deep-link plugin config — it does not
	     merge. So the dial8desktop scheme (desktop sign-in / OAuth callbacks and
	     deep links) MUST be listed here too, exactly as the bundler would write it;
	     dropping it silently breaks desktop sign-in. Keep this entry in sync with
	     plugins.deep-link.desktop.schemes in tauri.conf.json.

	     Native Intelligence never declares http/https: web links open in the system browser,
	     and Native Intelligence is never a default-browser choice. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.dial8.desktop dial8desktop</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dial8desktop</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
