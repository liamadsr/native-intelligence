+// ── .npy loading ────────────────────────────────────────────────────────────
+// Reads a little-endian float32, C-order .npy file into a flat vector.
+// Returns an empty vector when the file does not exist.
+
+static std::vector<float> load_npy_f32(const std::string& path) {
+    std::vector<char> raw;
+    FILE* f = std::fopen(path.c_str(), "rb");
+    if (!f) return {};
+    char buf[4096];
+    size_t got;
+    while ((got = std::fread(buf, 1, sizeof buf, f)) > 0) raw.insert(raw.end(), buf, buf + got);
+    std::fclose(f);
+
+    if (raw.size() < 10 || std::memcmp(raw.data(), "\x93NUMPY", 6) != 0)
+        throw std::runtime_error("Not a .npy file: " + path);
+    size_t off = raw[6] == 1 ? 10 : 12;
+    if (raw.size() < off) throw std::runtime_error("Truncated .npy file: " + path);
+    size_t hlen = uint8_t(raw[8]) | (size_t(uint8_t(raw[9])) << 8);
+    if (off == 12) hlen |= (size_t(uint8_t(raw[10])) << 16) | (size_t(uint8_t(raw[11])) << 24);
+    if (off + hlen > raw.size()) throw std::runtime_error("Truncated .npy file: " + path);
+    std::string header(raw.data() + off, hlen);
+    if (header.find("'<f4'") == std::string::npos || header.find("'fortran_order': False") == std::string::npos)
+        throw std::runtime_error("Unsupported .npy (need little-endian float32, C order): " + path);
+    size_t bytes = raw.size() - off - hlen;
+    if (bytes == 0 || bytes % sizeof(float) != 0) throw std::runtime_error("Bad .npy data size: " + path);
+
+    std::vector<float> out(bytes / sizeof(float));
+    std::memcpy(out.data(), raw.data() + off + hlen, bytes);
+    return out;
+}
+
