+    Tensor prepend_bos(Tensor v) const {
+        if (bos_.empty()) return v;
+        int64_t dim = v.shape.back();
+        if (dim <= 0 || bos_.size() % size_t(dim) != 0)
+            throw std::runtime_error("bos_before_voice.npy does not match the voice embedding size");
+        Tensor bos(bos_, {1, int64_t(bos_.size()) / dim, dim});
+        return Tensor::concat({bos, v}, 1);
     }
     
