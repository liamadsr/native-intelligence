+// ── Voices from precomputed embeddings ─────────────────────────────────────
+
+// Registers a voice from a precomputed embedding under `name`, for
+// ptt_stream_start: the Mimi encoder's output for a voice clip, float32,
+// shape [1, frames, dim] (ndims 3) or [frames, dim] (ndims 2), e.g. the data
+// of a .emb file from ptt_encode_voice. Needs no WAV and no
+// mimi_encoder.onnx, and writes nothing to disk. Call it before starting
+// streams. Returns 0 on success.
+int ptt_add_voice(void* handle, const char* name, const float* data, const int64_t* shape, int ndims) {
+    if (!handle || !name || !data || !shape || ndims < 2 || ndims > 3) return -1;
+    try {
+        std::vector<int64_t> sh(shape, shape + ndims);
+        for (auto d : sh) if (d <= 0) return -1;
+        size_t n = pocket_tts::calc_numel(sh);
+        static_cast<pocket_tts::PocketTTS*>(handle)->add_voice(name, pocket_tts::Tensor(std::vector<float>(data, data + n), sh));
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << "[pocket-tts] add_voice error: " << e.what() << "\n";
+        return -1;
+    }
+}
+
+// Encodes a voice clip (WAV, MP3 or FLAC) with mimi_encoder.onnx the way a
+// WAV voice is encoded at runtime (mono, resampled to 24 kHz, at most 30 s)
+// and writes the embedding to emb_path in the .emb cache format ("EMB1",
+// without the BOS). For making voice embeddings ahead of time; needs no
+// other model. Returns 0 on success.
+int ptt_encode_voice(const char* encoder_path, const char* audio_path, const char* emb_path, int num_threads) {
+    if (!encoder_path || !audio_path || !emb_path) return -1;
+    try {
+        Ort::SessionOptions opts;
+        opts.SetIntraOpNumThreads(num_threads > 0 ? num_threads : 2);
+        opts.SetInterOpNumThreads(1);
+        opts.SetGraphOptimizationLevel(GraphOptimizationLevel::ORT_ENABLE_ALL);
+        pocket_tts::OrtSession enc(pocket_tts::get_ort_env(), encoder_path, opts, "mimi_encoder");
+        auto r = pocket_tts::PocketTTS::run_encoder(enc, pocket_tts::PocketTTS::load_audio(audio_path));
+        if (!pocket_tts::cache::save_embedding(emb_path, r.shape, r.data))
+            throw std::runtime_error(std::string("cannot write ") + emb_path);
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << "[pocket-tts] encode_voice error: " << e.what() << "\n";
+        return -1;
+    }
+}
