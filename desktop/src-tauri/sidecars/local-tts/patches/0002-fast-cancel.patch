+// Stops a stream from any thread and returns at once: generation stops within
+// about a frame, and ptt_stream_read returns 0 from now on. The reading thread
+// still calls ptt_stream_end.
+void ptt_stream_cancel(void* stream_ctx) {
     if (!stream_ctx) return;
     auto* ctx = static_cast<ptt_stream_ctx*>(stream_ctx);
+    ctx->cancel = true;
+    bool running;
     {
         std::lock_guard<std::mutex> lock(ctx->mtx);
         ctx->aborted = true;
+        running = !ctx->done;
     }
+    if (running) ctx->tts->interrupt();
     ctx->cv.notify_all();
+}
