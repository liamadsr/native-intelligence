+void ptt_stream_end(void* stream_ctx) {
+    if (!stream_ctx) return;
+    auto* ctx = static_cast<ptt_stream_ctx*>(stream_ctx);
+    ptt_stream_cancel(ctx);  // a running stream now stops within about a frame
