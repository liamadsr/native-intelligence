+// Like ptt_create, with every model file named explicitly, so precisions can
+// be mixed (e.g. flow_lm_main_int8.onnx and flow_lm_flow_int8.onnx with the
+// full-precision mimi_decoder.onnx). mimi_encoder (only needed for WAV
+// voices) and bos_before_voice may be NULL: they are then looked for next to
+// flow_lm_main.
+void* ptt_create_from_files(const char* text_conditioner, const char* flow_lm_main,
+                            const char* flow_lm_flow, const char* mimi_decoder,
+                            const char* mimi_encoder, const char* tokenizer_path,
+                            const char* bos_before_voice,
+                            float temperature, int lsd_steps, int num_threads) {
+    if (!text_conditioner || !flow_lm_main || !flow_lm_flow || !mimi_decoder || !tokenizer_path) return nullptr;
+    try {
+        pocket_tts::Config cfg;
+        std::string main_path = flow_lm_main;
+        size_t slash = main_path.find_last_of("/\\");
+        cfg.models_dir = slash == std::string::npos ? "." : main_path.substr(0, slash);
+        cfg.text_conditioner_path = text_conditioner;
+        cfg.flow_lm_main_path = main_path;
+        cfg.flow_lm_flow_path = flow_lm_flow;
+        cfg.mimi_decoder_path = mimi_decoder;
+        if (mimi_encoder) cfg.mimi_encoder_path = mimi_encoder;
+        if (bos_before_voice) cfg.bos_path = bos_before_voice;
+        cfg.tokenizer_path = tokenizer_path;
+        cfg.temperature = temperature;
+        cfg.lsd_steps = lsd_steps;
+        cfg.num_threads = num_threads;
+        return new pocket_tts::PocketTTS(cfg);
+    } catch (const std::exception& e) {
+        std::cerr << "[pocket-tts] init error: " << e.what() << "\n";
+        return nullptr;
+    }
+}
