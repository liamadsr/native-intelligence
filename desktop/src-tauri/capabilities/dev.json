{
  "identifier": "dev-localhost",
  "description": "Debug builds only: build.rs reads this file for a debug build and leaves it out of a release build, so no released app grants anything to localhost. The same windows and permissions as default.json, for the local dev server dev.sh's build points the main window at (lib.rs setup). tests/capability_policy.rs pins that it mirrors default.json exactly and grants only http://localhost:3000.",
  "windows": [
    "main",
    "meeting-hud",
    "agent-hud",
    "dictate",
    "workspace-*",
    "studio-recorder"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
